rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Per-location logo uploads (max 5 MB, images only)
    match /locations/{locId}/logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Model background images — shared across locations (max 10 MB, images only)
    match /models/{modelId}/backgrounds/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Legacy logo path (max 5 MB, images only)
    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
