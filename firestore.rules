rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated ROA staff can write anything
    function isROA() {
      return request.auth != null
        && request.auth.token.email.matches('.*@rvsofamerica[.]com$');
    }

    // ── User → Location mapping ──
    match /users/{uid} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow create: if isROA() && request.auth.uid == uid;
      allow update: if isROA()
                    && request.auth.token.email in
                       get(/databases/$(database)/documents/locations/$(request.resource.data.locationId)).data.ownerEmails;
    }

    // ── Location docs ──
    match /locations/{locId} {
      allow read:   if true;
      allow create: if isROA();
      allow update: if isROA()
                    && request.auth.token.email in resource.data.ownerEmails;
      // Self-assignment: ROA user can add only their own email to ownerEmails
      allow update: if isROA()
                    && !(request.auth.token.email in resource.data.ownerEmails)
                    && request.auth.token.email in request.resource.data.ownerEmails
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerEmails'])
                    && request.resource.data.ownerEmails.size() == resource.data.ownerEmails.size() + 1;

      // Pages subcollection: public read (display screen), ROA-only write
      match /pages/{pageId} {
        allow read:  if true;
        allow write: if isROA()
                     && request.auth.token.email in
                        get(/databases/$(database)/documents/locations/$(locId)).data.ownerEmails;
      }
    }

    // ── Catalog: public read, ROA-only write ──
    match /manufacturers/{docId} {
      allow read:  if true;
      allow write: if isROA();
    }

    match /models/{docId} {
      allow read:  if true;
      allow write: if isROA();
    }

  }
}
